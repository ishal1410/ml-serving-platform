# Copy to .env — never commit .env
APP_NAME=ML Serving Platform
VERSION=1.0.0
ENVIRONMENT=development

# AWS — only needed for /load-model endpoint (S3 model storage)
# Leave blank to use the default ImageNet-pretrained weights
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=ml-models-bucket
MODEL_KEY=models/classifier.pt
